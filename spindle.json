{
  "version": "1.3.0",
  "name": "LumiScript",
  "identifier": "lumiscript",
  "author": "mindbound",
  "github": "https://github.com/mindbound/lumiscript",
  "homepage": "https://github.com/mindbound/lumiscript",
  "description": "A JavaScript scripting platform for Lumiverse. Write scripts that react to chat events, automate behaviour, and extend your AI chat experience.",
  "permissions": [
    "chat_mutation",
    "chats",
    "characters",
    "generation",
    "interceptor",
    "macro_interceptor",
    "cors_proxy",
    "ui_panels",
    "ephemeral_storage",
    "world_books",
    "databanks",
    "personas",
    "presets",
    "regex_scripts",
    "context_handler",
    "tools",
    "push_notification",
    "event_tracking",
    "app_manipulation",
    "images",
    "image_gen",
    "oauth",
    "web_search",
    "memories"
  ],
  "requested_capabilities": [
    "dynamic_code_execution"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "0.9.9",
  "interceptorTimeoutMs": 30000
}
