{
  "name": "lumiscript",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "bun build src/backend.ts --minify --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.tsx --minify --outfile dist/frontend.js --target browser",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun run typecheck && bun run build:backend && bun run build:frontend"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lumiverse-spindle-types": "^0.1.6",
    "typescript": "^5.9.3"
  }
}
