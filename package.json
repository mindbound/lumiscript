{
  "name": "lumiscript",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "bun build src/backend.ts --minify --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.tsx --minify --outfile dist/frontend.js --target browser",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:test": "bunx tsc --noEmit -p tsconfig.test.json",
    "build": "bun run typecheck && bun run build:backend && bun run build:frontend",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "pack2js": "bun scripts/pack2js.ts",
    "js2pack": "bun scripts/js2pack.ts"
  },
  "dependencies": {
    "@jsonquerylang/jsonquery": "^5.1.1",
    "@monaco-editor/react": "^4.7.0",
    "fflate": "^0.8.2",
    "handlebars": "^4.7.9",
    "lucide-react": "^1.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.13",
    "lumiverse-spindle-types": "^0.4.34",
    "typescript": "^6.0.3"
  }
}
